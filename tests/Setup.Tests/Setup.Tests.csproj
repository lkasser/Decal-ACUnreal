<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The setups' shared code is a Windows library, for its wizard; its install logic is what
         is tested here, against temporary folders and a registry held in memory. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Setup.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Setup.Common\Setup.Common.csproj" />
  </ItemGroup>

</Project>
